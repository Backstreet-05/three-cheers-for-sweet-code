---
import Base from '../layouts/Base.astro';
import { profile, about, experience, research, projects, skills, quips } from '../data/content';

const nav = [
  { label: 'about', href: '#about' },
  { label: 'experience', href: '#experience' },
  { label: 'research', href: '#research' },
  { label: 'projects', href: '#projects' },
  { label: 'skills', href: '#skills' },
  { label: 'github', href: profile.github, external: true },
  { label: 'linkedin', href: profile.linkedin, external: true },
  { label: 'email', href: `mailto:${profile.email}` },
];

const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base>
  <main>
    <header>
      <h1 class="name">{profile.name}<span class="cursor" aria-hidden="true"></span></h1>
      <p class="tagline">{profile.tagline}</p>
      <nav class="links" aria-label="primary">
        {nav.map((l) => <a href={l.href} {...(l.external ? ext : {})}>{l.label}</a>)}
      </nav>
    </header>

    <section id="about" class="prose">
      <h2><span class="num">01</span>about</h2>
      {about.map((p) => <p>{p}</p>)}
    </section>

    <section id="experience">
      <h2><span class="num">02</span>experience</h2>
      {experience.map((e) => (
        <div class="entry">
          <div class="entry-head">
            <span class="entry-title">{e.role}</span>
            <span class="meta">{e.period}</span>
          </div>
          <div class="sub">{e.org} · {e.place}</div>
          <ul class="points">{e.points.map((p) => <li>{p}</li>)}</ul>
          {e.link && (
            <div class="inline-links"><a href={e.link.href} {...ext}>{e.link.label}</a></div>
          )}
        </div>
      ))}
    </section>

    <section id="research">
      <h2><span class="num">03</span>research</h2>
      {research.map((r) => (
        <div class="entry">
          <div class="entry-head">
            <span class="entry-title">{r.title}</span>
          </div>
          {r.authors && <div class="sub">{r.authors.join(', ')}</div>}
          {r.venue && <div class="meta" style="margin-top:4px">{r.venue}</div>}
          <ul class="points">{r.points.map((p) => <li>{p}</li>)}</ul>
          <div class="inline-links">
            {r.links.map((l) => <a href={l.href} {...ext}>{l.label}</a>)}
          </div>
        </div>
      ))}
    </section>

    <section id="projects">
      <h2><span class="num">04</span>projects</h2>
      <div>
        {projects.map((p) => (
          <div class="project">
            <div class="project-head">
              <a class="project-name" href={p.repo} {...ext}>{p.name}<span class="arrow">↗</span></a>
              {p.demo && <a class="demo" href={p.demo} {...ext}>live demo</a>}
            </div>
            <p>{p.blurb}</p>
            <div class="stack">{p.stack.map((s) => <span>{s}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="skills">
      <h2><span class="num">05</span>skills</h2>
      <dl class="skills">
        {skills.map((s) => (<><dt>{s.label}</dt><dd>{s.items}</dd></>))}
      </dl>
    </section>

    <section id="contact" class="contact">
      <h2><span class="num">06</span>contact</h2>
      <p>
        best way to reach me is <a href={`mailto:${profile.email}`}>{profile.email}</a>, or say hi on{' '}
        <a href={profile.linkedin} {...ext}>linkedin</a>.
      </p>
    </section>

    <footer>
      <span>{profile.location}</span>
      <span>{quips.footer}</span>
    </footer>
  </main>
</Base>
